generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships   Membership[]
  expenses      Expense[]
  reminders     Reminder[]
  shoppingItems ShoppingItem[]
  shoppingTrips ShoppingTrip[]
  activities    Activity[]
  budgets       Budget[]
  sentMessages  ChatMessage[]
  createdInvites FamilyInvite[] @relation("InviteCreator")
}

model Family {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members       Membership[]
  expenses      Expense[]
  reminders     Reminder[]
  shopping      ShoppingItem[]
  shoppingTrips ShoppingTrip[]
  activities    Activity[]
  budgets       Budget[]
  chat          ChatMessage[]
  invites       FamilyInvite[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  familyId String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
}

// familyId is nullable so Single-mode data is owned only by userId.
model Expense {
  id        String   @id @default(cuid())
  familyId  String?
  userId    String
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  currency  String   @default("SEK")
  category  String
  note      String?
  date      DateTime
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([userId, date])
}

model Budget {
  id        String   @id @default(cuid())
  scopeKey  String
  familyId  String?
  userId    String
  month     String   // YYYY-MM
  amount    Decimal  @db.Decimal(12, 2)
  currency  String   @default("SEK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, month])
  @@index([userId, month])
  @@unique([scopeKey, month])
}

model Reminder {
  id                  String   @id @default(cuid())
  familyId            String?
  userId              String
  title               String
  date                DateTime
  time                String?
  repeat              String   @default("NONE")
  type                String   @default("REMINDER")
  category            String   @default("Other")
  remindBeforeMinutes Int      @default(0)
  sound               String   @default("soft")
  notified            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, date])
  @@index([userId, date])
}

model ShoppingTrip {
  id             String    @id @default(cuid())
  familyId       String?
  userId         String
  name           String    @default("Shopping trip")
  store          String?
  estimatedTotal Decimal   @default(0) @db.Decimal(12, 2)
  actualTotal    Decimal?  @db.Decimal(12, 2)
  currency       String    @default("SEK")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  family Family?        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  ShoppingItem[]

  @@index([familyId, completedAt])
  @@index([userId, completedAt])
}

model ShoppingItem {
  id                 String    @id @default(cuid())
  familyId           String?
  userId             String
  tripId             String?
  name               String
  done               Boolean   @default(false)
  assigneeId         String?
  category           String    @default("Other")
  quantity           Decimal   @default(1) @db.Decimal(10, 2)
  unit               String    @default("piece")
  estimatedUnitPrice Decimal?  @db.Decimal(12, 2)
  store              String?
  notes              String?
  purchasedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  family Family?       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip   ShoppingTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([familyId, done])
  @@index([userId, done])
  @@index([tripId])
}

model Activity {
  id         String   @id @default(cuid())
  familyId   String?
  userId     String
  title      String
  assigneeId String?
  dueDate    DateTime?
  done       Boolean  @default(false)

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model FamilyInvite {
  id          String    @id @default(cuid())
  familyId    String
  createdById String
  code        String    @unique
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model ChatMessage {
  id        String    @id @default(cuid())
  familyId  String
  userId    String
  message   String
  isVoice   Boolean   @default(false)
  duration  Int       @default(0)
  replyToId String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  family  Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo ChatMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("MessageReplies")

  @@index([familyId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
