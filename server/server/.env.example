# =====================================================================
# Server environment — COPY this file to `.env` and fill in real values.
# NEVER commit `.env` to git (it's in .gitignore).
# =====================================================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL (your local database)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example with your setup:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/family_expense_tracker"

# JWT secrets — use LONG random strings.
# Generate:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=change_me_to_a_long_random_string
REFRESH_TOKEN_SECRET=change_me_to_a_different_long_random_string

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
